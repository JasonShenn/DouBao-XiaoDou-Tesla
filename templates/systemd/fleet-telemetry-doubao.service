# 占位符说明：<SERVER_USER> 是服务器登录用户名（如 ubuntu）；
# <APP_NAME> 是应用名/部署代号（英文，如 DoubaoTesla），服务名、目录名共用它。
# 全部占位符对照见 README 第 1 节。
[Unit]
Description=Tesla Fleet Telemetry receiver (<APP_NAME>)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 用 root 跑：要读 /etc/letsencrypt/live/<TELEMETRY_DOMAIN>/privkey.pem（默认 root 600）
User=root
WorkingDirectory=/home/<SERVER_USER>/fleet-telemetry-<APP_NAME>
ExecStart=/home/<SERVER_USER>/fleet-telemetry-<APP_NAME>/fleet-telemetry -config /home/<SERVER_USER>/fleet-telemetry-<APP_NAME>/consumer/server_config.json
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
